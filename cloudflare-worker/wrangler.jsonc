{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huquqai-rag",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "huquqai-legal-v1"
    }
  ]
}
